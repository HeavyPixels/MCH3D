create_clock -name {clk_in} -period 83.3333333333333 [get_ports clk_in]
create_generated_clock -name {clk} -source [get_ports clk_in] -multiply_by 3 [get_nets clk] 
#create_clock -name {spi_clk} -period 12.5 [get_ports spi_clk]
#set_clock_groups -asynchronous -group [get_clocks clk_in] -group [get_clocks spi_clk]
set_output_delay 5 -max -clock [get_clocks clk] [get_ports {lcd_d[0]}]
set_output_delay 5 -max -clock [get_clocks clk] [get_ports {lcd_d[1]}]
set_output_delay 5 -max -clock [get_clocks clk] [get_ports {lcd_d[2]}]
set_output_delay 5 -max -clock [get_clocks clk] [get_ports {lcd_d[3]}]
set_output_delay 5 -max -clock [get_clocks clk] [get_ports {lcd_d[4]}]
set_output_delay 5 -max -clock [get_clocks clk] [get_ports {lcd_d[5]}]
set_output_delay 5 -max -clock [get_clocks clk] [get_ports {lcd_d[6]}]
set_output_delay 5 -max -clock [get_clocks clk] [get_ports {lcd_d[7]}]
set_output_delay 5 -max -clock [get_clocks clk] [get_ports lcd_rs]
set_output_delay 5 -max -clock [get_clocks clk] [get_ports lcd_wr_n]
set_output_delay 5 -max -clock [get_clocks clk] [get_ports lcd_cs_n]
set_output_delay 5 -max -clock [get_clocks clk] [get_ports lcd_rst_n]
set_output_delay -2 -min -clock [get_clocks clk] [get_ports {lcd_d[0]}]
set_output_delay -2 -min -clock [get_clocks clk] [get_ports {lcd_d[1]}]
set_output_delay -2 -min -clock [get_clocks clk] [get_ports {lcd_d[2]}]
set_output_delay -2 -min -clock [get_clocks clk] [get_ports {lcd_d[3]}]
set_output_delay -2 -min -clock [get_clocks clk] [get_ports {lcd_d[4]}]
set_output_delay -2 -min -clock [get_clocks clk] [get_ports {lcd_d[5]}]
set_output_delay -2 -min -clock [get_clocks clk] [get_ports {lcd_d[6]}]
set_output_delay -2 -min -clock [get_clocks clk] [get_ports {lcd_d[7]}]
set_output_delay -2 -min -clock [get_clocks clk] [get_ports lcd_rs]
set_output_delay -2 -min -clock [get_clocks clk] [get_ports lcd_wr_n]
set_output_delay -2 -min -clock [get_clocks clk] [get_ports lcd_cs_n]
set_output_delay -2 -min -clock [get_clocks clk] [get_ports lcd_rst_n]